<?xml version="1.0" encoding="utf-8"?>
<!-- Generated: RemoteViews-safe views only (FrameLayout, LinearLayout, ImageView, TextClock, TextView). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/w_root_click"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@string/widget_clock"
    android:padding="@dimen/widget_outer_padding">

    <FrameLayout
        android:id="@android:id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToOutline="true"
        tools:targetApi="31">
        <ImageView
            android:id="@+id/w_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_bg"
            android:tint="@color/widget_default_screen" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/widget_inner_padding">
            <LinearLayout
                android:id="@+id/w_cards"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <FrameLayout
                    android:id="@+id/w_card1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">
                        <ImageView
                            android:id="@+id/w_card1_top"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/wcard_top"
                            android:tint="@color/widget_default_card_top" />
                        <ImageView
                            android:id="@+id/w_card1_bottom"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/wcard_bottom"
                            android:tint="@color/widget_default_card_bottom" />
                    </LinearLayout>
                    <TextClock
                        android:id="@+id/w_hour"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:autoSizeMaxTextSize="260sp"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="sans-serif"
                        android:format12Hour="h"
                        android:format24Hour="HH"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:padding="@dimen/widget_digit_padding"
                        android:textColor="@color/widget_default_digit"
                        android:textStyle="bold" />
                    <TextClock
                        android:id="@+id/w_ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="@dimen/widget_ampm_margin"
                        android:layout_marginTop="@dimen/widget_ampm_margin"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:includeFontPadding="false"
                        android:letterSpacing="0.08"
                        android:textColor="@color/widget_default_accent"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                    <ImageView
                        android:id="@+id/w_card1_seam"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/widget_seam"
                        android:layout_gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/wseam"
                        android:tint="@color/widget_default_screen" />
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/w_card2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/widget_card_gap">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">
                        <ImageView
                            android:id="@+id/w_card2_top"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/wcard_top"
                            android:tint="@color/widget_default_card_top" />
                        <ImageView
                            android:id="@+id/w_card2_bottom"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/wcard_bottom"
                            android:tint="@color/widget_default_card_bottom" />
                    </LinearLayout>
                    <TextClock
                        android:id="@+id/w_minute"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:autoSizeMaxTextSize="260sp"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="sans-serif"
                        android:format12Hour="mm"
                        android:format24Hour="mm"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:padding="@dimen/widget_digit_padding"
                        android:textColor="@color/widget_default_digit"
                        android:textStyle="bold" />
                    <ImageView
                        android:id="@+id/w_card2_seam"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/widget_seam"
                        android:layout_gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/wseam"
                        android:tint="@color/widget_default_screen" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
