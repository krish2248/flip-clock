<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: settings move with the user. Widget ids are per device, so not restored. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="flip_widgets.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="flip_widgets.xml" />
    </device-transfer>
</data-extraction-rules>
